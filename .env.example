NODE_ENV=development
PORT=3000

# PostgreSQL — shared by all three pokedex services (required to run)
DATABASE_URL=postgres://pokedex:pokedex@localhost:5432/pokedex

# External PokeAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Redis L2 cache — OPTIONAL. Empty = L1-only mode. Same URL in all services.
REDIS_URL=redis://localhost:6379

# JWT — MUST be identical across all three services (tokens are interchangeable).
# Secret must be at least 32 characters (HS256 key size requirement in .NET).
JWT_SECRET=change-me-to-a-shared-secret-of-32-chars-min
JWT_ISSUER=pokedex-api
JWT_AUDIENCE=pokedex-clients
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=24

# bcrypt cost — MUST match across services ($2b$, cost 12)
BCRYPT_COST=12

# Cache TTLs (seconds)
CACHE_L1_TTL_SECONDS=300
CACHE_L2_TTL_SECONDS=3600
