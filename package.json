{
  "name": "pokedex-api-express-js",
  "version": "0.1.0",
  "private": true,
  "description": "Pokedex REST API — Express 5 + JavaScript, clean architecture, PostgreSQL (Drizzle) and two-tier PokeAPI caching",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon src/Server.js",
    "start": "node src/Server.js",
    "lint": "eslint src",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "prepare": "husky"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "cross-env": "10.1.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "nodemon": "3.1.14"
  }
}
